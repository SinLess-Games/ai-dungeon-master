# =============================================================================
# Endless Codex - Environment Variable Template
# =============================================================================
#
# Copy this file to the appropriate local environment file and fill in values.
#
# IMPORTANT:
# - Never commit real secrets.
# - Variables prefixed with VITE_ are bundled into browser code.
# - NEVER place passwords, OAuth client secrets, API secrets, or database
#   credentials in VITE_ variables.
#
# Local Cloudflare Worker secrets should normally live in:
#   .dev.vars
#
# Production secrets should be configured through Cloudflare.
#
# =============================================================================


# -----------------------------------------------------------------------------
# Application - server
# -----------------------------------------------------------------------------

# Canonical public URL for Endless Codex.
#
# Local:
#   http://localhost:5173
#
# Production:
#   https://endless-codex.sinlessindustries.com
APP_URL=http://localhost:5173

# Runtime environment identifier.
#
# Expected values:
#   development
#   preview
#   production
ENVIRONMENT=development

# Application/build metadata.
#
# These are optional locally and may be populated automatically by CI/CD.
APP_VERSION=
BUILD_ID=
GIT_COMMIT_SHA=

NODE_ENV=development


# -----------------------------------------------------------------------------
# Application - browser-safe
# -----------------------------------------------------------------------------
#
# WARNING:
# Every VITE_ variable is exposed to the browser.
# Never place secrets in this section.
#

# API origin used by the React application.
#
# Web:
# Leave empty to use the current origin:
#   /api/...
#
# Android / Tauri:
# Set to the hosted Endless Codex origin:
#   https://endless-codex.sinlessindustries.com
VITE_API_BASE_URL=


# -----------------------------------------------------------------------------
# Cloudflare / Drizzle tooling - server/tooling only
# -----------------------------------------------------------------------------
#
# Used by local Node-based tooling such as Drizzle Kit.
#
# These values must NEVER be exposed through VITE_ variables.
#

CLOUDFLARE_ACCOUNT_ID=

# Endless Codex D1 database ID.
CLOUDFLARE_DATABASE_ID=dc744f5a-7c53-4d37-b695-97b2527ef06a

# Cloudflare API token with only the permissions required for D1 tooling.
CLOUDFLARE_D1_TOKEN=


# -----------------------------------------------------------------------------
# Better Auth - server-only
# -----------------------------------------------------------------------------
#
# NEVER prefix these values with VITE_.
#

# Strong secret used by Better Auth for cryptographic operations.
#
# Generate a secure random value for each environment.
BETTER_AUTH_SECRET=

# Base URL Better Auth should use when constructing authentication URLs.
#
# Local:
#   http://localhost:5173
#
# Production:
#   https://endless-codex.sinlessindustries.com
BETTER_AUTH_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Google OAuth - server-only
# -----------------------------------------------------------------------------
#
# Configure these in Google Cloud Console.
#
# Do not expose GOOGLE_CLIENT_SECRET to the browser.
#

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# Discord OAuth - server-only
# -----------------------------------------------------------------------------
#
# Configure these in the Discord Developer Portal.
#
# Do not expose DISCORD_CLIENT_SECRET to the browser.
#

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=


# -----------------------------------------------------------------------------
# AI workflows - server-only
# -----------------------------------------------------------------------------
#
# Production uses the Cloudflare Workers AI binding configured in wrangler.jsonc.
# That is the default/free setup and requires NO AI_API_KEY.
#
# AI_DEVBLOG_MODEL controls the weekly/admin devblog writer.
# AI_GAME_MODEL controls the in-campaign AI Dungeon Master.
# The production defaults are configured in wrangler.jsonc.
AI_DEVBLOG_MODEL=
AI_GAME_MODEL=

# Optional fallback for development or a non-Cloudflare deployment.
# Leave blank when using the Workers AI binding.
AI_API_KEY=
AI_BASE_URL=

# Private repository source material for the weekly devblog writer. In production
# wrangler.jsonc already supplies the repository name, but it can be overridden.
GITHUB_REPOSITORY=SinLess-Games/ai-dungeon-master
GITHUB_TOKEN=

# Generation defaults to enabled and draft-only. Set auto publish to true only
# after you trust the generated articles enough to publish without review.
DEVBLOG_AI_ENABLED=true
DEVBLOG_AI_AUTO_PUBLISH=false

# Optional. If blank, scheduled generation uses the oldest administrator account.
# If set, it must match an existing administrator email.
DEVBLOG_AI_AUTHOR_EMAIL=


# -----------------------------------------------------------------------------
# Seed administrator - server/tooling only
# -----------------------------------------------------------------------------
#
# Used only by the administrator seed command.
#
# The seed must be idempotent and must never print the password.
#

SEED_ADMIN_EMAIL=timothy.pierce444@gmail.com
SEED_ADMIN_USERNAME=Sinless777

# Intentionally blank.
#
# Set this only in the local/private environment used when running the seed.
# Never commit the real administrator password.
SEED_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# Stripe - browser-safe
# -----------------------------------------------------------------------------
#
# Stripe publishable keys are safe to expose to browser code.
#
# Local/development:
#   Use a Stripe test/sandbox publishable key.
#
# Production:
#   Supply the live publishable key through the deployment environment.
#

VITE_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# Stripe - server-only
# -----------------------------------------------------------------------------
#
# NEVER prefix these values with VITE_.
#

# Secret API key used by server-side Stripe operations.
STRIPE_API_KEY=

# Secret used to verify incoming Stripe webhook signatures.
STRIPE_WEBHOOK_SECRET=
