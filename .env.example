# -----------------------------------------------------------------------------
# Cloudflare / Drizzle tooling
# -----------------------------------------------------------------------------
# Used by local Node-based tooling such as Drizzle Kit.
# Do not expose these values to the browser.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=dc744f5a-7c53-4d37-b695-97b2527ef06a
CLOUDFLARE_D1_TOKEN=


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------

# Public URL of the deployed Endless Codex application.
APP_URL=https://endless-codex.sinlessindustries.com

# Browser API base URL.
#
# Leave empty for the web build so requests use the same origin:
#   /api/...
#
# Android / Tauri builds can override this with:
#   https://endless-codex.sinlessindustries.com
VITE_API_BASE_URL=


# -----------------------------------------------------------------------------
# Stripe - browser-safe values only
# -----------------------------------------------------------------------------
# Publishable keys are safe to expose to the browser.
#
# Use the sandbox key for local development.
# Production should receive the live key from the deployment environment.

VITE_STRIPE_PUBLISHABLE_KEY=


# -----------------------------------------------------------------------------
# Development
# -----------------------------------------------------------------------------

NODE_ENV=development
# Auth and OAuth secrets belong in .dev.vars / Cloudflare secrets, never VITE_ variables.
