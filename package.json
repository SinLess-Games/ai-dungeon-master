{
  "name": "the-endless-codex",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "predev": "npm run db:migrate:local",
    "dev": "vite",
    "dev:raw": "vite",
    "build": "vite build && npm run typecheck",
    "build:dev": "vite build --mode development && npm run typecheck",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:ci": "vitest run --exclude \"tests/unit/*seed*.test.ts\"",
    "test:unit:seeds": "vitest run seed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:campaign": "node tests/e2e/campaign-creator.e2e.mjs",
    "test:e2e:campaign-play": "node tests/e2e/campaign-play.e2e.mjs",
    "test:e2e:ai-dm-tools": "node tests/e2e/ai-dm-state-tools.e2e.mjs",
    "test:e2e:creator": "node tests/e2e/character-creator.e2e.mjs && node tests/e2e/character-creator-ui.e2e.mjs && node tests/e2e/character-creator-guardrails.e2e.mjs && node tests/e2e/character-creator-supplement-classes.e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed:local": "node scripts/seed-content.mjs --local --migrate-local",
    "db:seed:remote": "node scripts/seed-content.mjs --remote",
    "db:studio": "drizzle-kit studio",
    "cf:typegen": "wrangler types",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "db:seed:admin": "node scripts/seed-admin.mjs",
    "test:auth:integration": "node scripts/verify-auth.mjs",
    "test:auth:browser": "node scripts/verify-auth-browser.mjs",
    "db:seed:admin:remote": "node --env-file=.prod.vars scripts/seed-admin.mjs --remote",
    "test:devblog": "node scripts/verify-devblog.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@ai-sdk/react": "^4.0.96",
    "@base-ui/react": "^1.8.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^5.9.1",
    "@stripe/react-stripe-js": "^6.9.0",
    "@stripe/stripe-js": "^9.15.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-plugin": "^1.168.35",
    "@tauri-apps/api": "^2.11.1",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.41.0",
    "pixi.js": "^8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.1.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}