{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",

  "productName": "The Endless Codex",
  "version": "0.1.0",
  "identifier": "com.sinlessindustries.endlesscodex",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:web",

    "devUrl": "http://localhost:5173",
    "frontendDist": "https://endless-codex.sinlessindustries.com"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "The Endless Codex",

        "width": 1440,
        "height": 900,

        "minWidth": 1024,
        "minHeight": 700,

        "center": true,

        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,

        "decorations": true,
        "transparent": false,
        "fullscreen": false,

        "visible": true,
        "focus": true
      }
    ],

    "security": {}
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "category": "RolePlayingGame",

    "publisher": "SinLess Industries",
    "homepage": "https://endless-codex.sinlessindustries.com",

    "shortDescription": "Persistent fantasy campaigns powered by an AI Dungeon Master.",

    "longDescription": "The Endless Codex is an AI-powered fantasy tabletop RPG experience featuring persistent campaigns, rules-aware character management, character creation, combat, spellcasting, psionics, and an AI Dungeon Master.",

    "copyright": "Copyright © 2026 SinLess Industries",

    "createUpdaterArtifacts": false,

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "windows": {
      "allowDowngrades": false,

      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },

    "linux": {
      "appimage": {
        "bundleMediaFramework": false,
        "files": {}
      },

      "deb": {
        "files": {}
      },

      "rpm": {
        "epoch": 0,
        "release": "1",
        "files": {}
      }
    },

    "macOS": {
      "minimumSystemVersion": "10.13",
      "hardenedRuntime": true
    }
  }
}